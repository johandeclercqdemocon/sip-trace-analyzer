# Local environments and build output
.venv/
web/node_modules/
web/dist/
web/tsconfig.tsbuildinfo
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Secrets — never commit
.env

# rfc/ and iana/ are committed on purpose: the project builds its knowledge base
# offline. Refresh them with `make corpus` when a referenced RFC is revised.

# Generated by the test suite
tests/data/

# Captures. Traces are customer data; keep them out of the repository.
*.pcap
*.pcapng
*.cap

# Real traces kept locally to develop readers against. An OCOM message-flow
# export carries dialled numbers, device names and internal addressing, so the
# folder stays out of the repository; the test fixtures are synthetic.
trace_format_examples/
